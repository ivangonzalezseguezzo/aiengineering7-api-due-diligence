# Copiá este archivo a .env y completá las claves. NUNCA subas el .env a GitHub.

# --- Redis (estado de los jobs, cola y checkpoints de LangGraph) ---
# Tiene que ser Redis 8 o Redis Stack (el checkpointer usa Search y JSON). Opciones:
#   docker compose up      -> lo levanta solo (este valor se pisa por redis://redis:6379/0)
#   Redis Cloud (gratis)   -> redis://default:<contraseña>@<host>:<puerto>
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIJO=dd

# --- API ---
# Clave del header X-API-Key para POST /tasks/{id}/approve. La de ejemplo sirve para probar el
# proyecto recién clonado; para cualquier uso real generá una larga y aleatoria, por ejemplo con
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEY_APROBACION=clave-de-prueba-cambiala
# jobs simultáneos del worker (la prueba de carga manda 5)
WORKER_CONCURRENCIA=5

# --- Observabilidad (LangSmith) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=due-diligence-pe7-produccion
# solo si tu cuenta está en la región EU
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Proveedor del LLM: gemini | openai | anthropic ---
LLM_PROVIDER=gemini

# --- API keys (solo hace falta la del proveedor elegido) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Modelos (opcional; si se omiten se usan los valores por defecto) ---
# IDs reales (ver tabla "Modelos" del README). Flash Lite: 15 requests/min y 500/día en el plan gratuito.
GEMINI_MODEL=gemini-3.5-flash-lite
# Respaldo automático si el principal responde 503 (saturado) o 429 (cupo): la cuota es por modelo.
GEMINI_MODEL_RESPALDO=gemini-3.1-flash-lite
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Parámetros del LLM (opcional) ---
# Gemini 3.x y Anthropic lo ignoran con un aviso (sampling fijo / 400)
# LLM_TEMPERATURE=0
# solo Gemini 3: low | medium | high
LLM_THINKING_LEVEL=low
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=30
# reintentos propios ante errores transitorios (nunca el cupo diario)
LLM_MAX_RETRIES=2
# un solo worker = un solo balde: Flash Lite permite 15/min
LLM_REQUESTS_PER_MINUTE=12

# --- Búsqueda web del investigador (opcional) ---
# Sin clave, buscar_mercado usa los informes de mercado locales (due_diligence/data/mercado).
TAVILY_API_KEY=

# --- Orquestador (opcional; estos son los valores por defecto) ---
# el código decide el orden natural; el LLM, solo las elecciones reales
# DD_SUPERVISOR_HIBRIDO=true
# el investigador recibe el data room y el informe de mercado de entrada
# DD_PRECARGAR_DATA_ROOM=true
# human-in-the-loop: "criticidad" pausa solo los casos críticos; "siempre" pausa todos (demo)
# DD_HITL_MODO=criticidad
# puntos de score alrededor de un umbral de banda (50 y 70) que se consideran ambiguos
# DD_HITL_MARGEN_AMBIGUEDAD=5
# veces que el comité puede pedir "otra vuelta"
# DD_MAX_RONDAS_HUMANAS=2
# decisiones del supervisor por análisis (+4 por cada ronda humana)
# DD_MAX_PASOS=12
# veces que se puede delegar en cada especialista (+1 por ronda humana)
# DD_MAX_INTENTOS_INVESTIGADOR=3
# DD_MAX_INTENTOS_ANALISTA=3
# DD_MAX_INTENTOS_CRITICO=2
# rondas de herramientas por invocación de un especialista
# DD_MAX_ITERACIONES_ESPECIALISTA=6
# techo duro de LangGraph por ejecución
# DD_RECURSION_LIMIT=40
# modelo propio para el supervisor (por defecto, el mismo)
# DD_MODELO_SUPERVISOR=
